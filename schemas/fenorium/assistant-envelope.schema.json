{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fenorium.com/schemas/assistant-envelope.schema.json",
  "title": "AssistantEnvelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "method_version", "as_of", "facts"],
  "properties": {
    "schema_version": {"const": "fenorium/assistant-envelope/1"},
    "method_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "as_of": {"$ref": "common.schema.json#/$defs/utcTimestamp"},
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/fact"}
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "string",
      "minLength": 2,
      "maxLength": 512,
      "pattern": "^(?:[a-z][a-z0-9+.-]*:|[a-z][a-z0-9_-]*[/#])[^\\u0000-\\u0020\\u007f]+$"
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_ref", "status", "reason_code", "value", "unit"],
      "properties": {
        "field_ref": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[a-z][a-z0-9_-]*(?:(?:[/:.])[A-Za-z0-9_-]+|\\[[0-9]+\\])+$"
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z][A-Za-z0-9 _-]*$"
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "value": {"type": ["integer", "string", "boolean", "null"]},
        "unit": {
          "type": ["string", "null"],
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9%_./:-]+$"
        },
        "source_ref": {"$ref": "#/$defs/sourceRef"},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sourceRef"}
        },
        "label": {"type": "string", "maxLength": 256}
      },
      "anyOf": [
        {"required": ["source_ref"]},
        {"required": ["source_refs"]}
      ]
    }
  }
}
