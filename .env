# Fenorium local settings. This file is committed on purpose: every value is public.
#
# The keys below are Anvil's published development accounts (the standard
# "test test test test test test test test test test test junk" mnemonic). They exist on every
# Anvil chain with 10,000 ETH each, they are known to the whole world, and they must never hold
# anything on a real network.
#
# Account #0 deploys everything and is the trusted attester; accounts #0, #1 and #2 receive the
# demo credential, so they can buy the gated instruments too.
LOCAL_DEPLOYER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
LOCAL_RECIPIENT_KEYS=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80,0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d,0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a

# Ports on 127.0.0.1.
LOCAL_CHAIN_PORT=8545
LOCAL_PLATFORM_PORT=8517

# The chat assistant (optional, see README). The token is shared by the platform and the assistant
# container only; nothing else can reach the assistant.
LOCAL_ASSISTANT_PAIRING_TOKEN=fenorium-local-assistant-pairing-token-0001
# The model: qwen3-1.7b (default on a CPU), qwen3-4b, or qwen3-8b (default with GPU=1).
# LOCAL_ASSISTANT_MODEL=qwen3-1.7b
# The model's window in tokens; the platform fits every prompt to it.
# LOCAL_ASSISTANT_CTX=8192
